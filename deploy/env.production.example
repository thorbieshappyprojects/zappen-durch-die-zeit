# Production environment for deploy/compose.yml – copy to /opt/zadudize/.env (mode 600) and fill in.
# Names and comments only. New secrets for production: generate on the server with `openssl rand -hex 32`.
# The keys of the curation scripts (YouTube Data API, Internet Archive) do not belong here.

# --- Site -------------------------------------------------------------------------------------
# Public address (share previews, sitemap, robots.txt). Required.
SITE_URL=https://zadudize.de
# Domain Caddy requests the certificate for (www. redirects to it).
SITE_DOMAIN=zadudize.de
# „Quellcode“ link (AGPL-3.0).
SOURCE_URL=https://github.com/thorbieshappyprojects/zappen-durch-die-zeit
# 1 = search engines may index the day listings of real days (owner decision 10 Nov 2026).
PUBLISH_LISTINGS=1

# --- Image ------------------------------------------------------------------------------------
# Image tag to run: latest, a commit hash (rollback) or a version.
APP_TAG=latest

# --- Database ---------------------------------------------------------------------------------
# Password of the Postgres user zadudize (hex: it goes into DATABASE_URL unescaped).
# DATABASE_URL itself is built from it in compose.yml.
POSTGRES_PASSWORD=

# --- Secrets ----------------------------------------------------------------------------------
# Form tokens and the daily address hash, at least 32 characters.
CONTRIBUTION_SECRET=
# Admin password, at least 20 characters (password manager).
ADMIN_TOKEN=
# Two-factor secret: docker compose run --rm jobs pnpm ingest admin-totp --print
ADMIN_TOTP_SECRET=

# --- Proxy ------------------------------------------------------------------------------------
# Caddy passes the visitor address on the right of X-Forwarded-For: one trusted proxy.
TRUSTED_PROXY_HOPS=1

# --- Owner (Impressum, Datenschutzerklärung) – only here, never in the repository --------------
OWNER_NAME=
OWNER_ADDRESS=
OWNER_EMAIL=dev@thorbieshappyprojects.com

# --- Paths inside the image (defaults set in the Dockerfile; change only with the volumes) -----
UPLOAD_DIR=/data/uploads
MIGRATIONS_DIR=/app/packages/db/drizzle
ARCHIVE_SEED_DIR=/import/tvprogramme.net-seed

# --- Contribution attachments -----------------------------------------------------------------
# Quotas in MB for all visitors together (defaults: 500 per 24 h, 5000 in total).
UPLOAD_DAILY_QUOTA_MB=
UPLOAD_TOTAL_QUOTA_MB=

# --- Site lock before the launch --------------------------------------------------------------
# Both set: every page except /healthz asks for this user and password.
# Hash: docker run --rm -it caddy:2 caddy hash-password – put it in single quotes ('$2a$14$…'), or Compose reads the $ as variables.
# Empty both and restart Caddy (docker compose up -d caddy) to open the site.
SITE_LOCK_USER=
SITE_LOCK_HASH=

# --- Backups (deploy/backup.sh) ---------------------------------------------------------------
# age public key for the encrypted off-server copy (age-keygen; the private key stays with the owner).
BACKUP_AGE_RECIPIENT=
# Off-server target, e.g. sftp://user@host/backup-zadudize or ftps://… (empty = local copies only).
BACKUP_REMOTE=
# Password of that account (leave empty for an SSH key).
BACKUP_REMOTE_PASSWORD=
