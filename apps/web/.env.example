# Copy to apps/web/.env.local (git-ignored) and fill in. Names and purpose only – never commit values.
# In production the server refuses to start without CONTRIBUTION_SECRET and SITE_URL (instrumentation.ts).

# Public address of the site, e.g. https://example.org (link previews, sitemap, robots.txt). Required in production.
SITE_URL=
# Secret for form tokens and daily IP hashes, at least 32 characters (e.g. `openssl rand -hex 32`). Required in production.
CONTRIBUTION_SECRET=
# Admin password for /admin, at least 20 characters in production. Unset = no admin.
ADMIN_TOKEN=
# Two-factor secret for /admin, written by `pnpm ingest admin-totp`. Required in production for the admin to work.
ADMIN_TOTP_SECRET=

# Client address for rate limits (see README "Hosting: Client-Adresse"):
# a header the platform sets itself (e.g. cf-connecting-ip); if set, used alone.
CLIENT_IP_HEADER=
# Otherwise: number of proxies in front that append to X-Forwarded-For (default 1; 0 = trust none).
TRUSTED_PROXY_HOPS=

# Owner details for Impressum and Datenschutzerklärung (placeholders until set).
OWNER_NAME=
OWNER_ADDRESS=
OWNER_EMAIL=

# Upload quotas for Mitmachen attachments, in MB (defaults 500 per 24 h and 5000 in total).
UPLOAD_DAILY_QUOTA_MB=
UPLOAD_TOTAL_QUOTA_MB=
# Where uploaded files are stored (default .data/uploads in the repository).
UPLOAD_DIR=
# Paths for a built image (defaults: inside the repository).
# Drizzle migrations (default packages/db/drizzle).
MIGRATIONS_DIR=
# The curation's review file shown at /admin/aussortiert (default seed/upload-review.json; absent = „Keine Daten“).
UPLOAD_REVIEW_FILE=
# Folder with the converted tvprogramme.net days for `pnpm ingest import archive` (default .data/archive/tvprogramme.net-seed).
ARCHIVE_SEED_DIR=

# Postgres connection; unset = local PGlite in .data/pglite (ZDZ_PGLITE_DIR overrides that folder).
# Required in production: the server refuses to start without it (never PGlite there).
DATABASE_URL=
ZDZ_PGLITE_DIR=
# Public source repository linked as „Quellcode“ on Info and Impressum (AGPL-3.0); default the GitHub repository.
SOURCE_URL=
# 1 = let search engines index the day listings with a permissive licence (/tag/<date>/programm, sitemap).
PUBLISH_LISTINGS=
# Dailymotion player ID from a (free) partner account; without it Dailymotion videos are link-outs.
NEXT_PUBLIC_DAILYMOTION_PLAYER_ID=

# 1 = send the Content-Security-Policy as report-only (to try a policy change without blocking).
CSP_REPORT_ONLY=

# Curation scripts only (not read by the web app): YouTube Data API key for the video search.
YOUTUBE_API_KEY=
